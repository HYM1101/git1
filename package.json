{
  "name": "ec-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:pc": "vite",
    "build": "node scripts/build-all.mjs",
    "build:pc": "vue-tsc --noEmit && vite build",
    "build:e2e": "vite build --mode development",
    "build:analyze": "node scripts/build-analyze.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json}\" \"*.{json,js,ts}\"",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:visual": "node scripts/run-e2e.mjs e2e/visual-regression.spec.ts",
    "test:visual:update": "node scripts/run-e2e.mjs --update-snapshots=all e2e/visual-regression.spec.ts",
    "visual:compare": "node scripts/run-visual-compare.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run lint:style && npm run typecheck && npm run test:unit && npm run build",
    "gen:api": "bash scripts/gen-api.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "axios-mock-adapter": "^2.1.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "~5.8.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.7",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
